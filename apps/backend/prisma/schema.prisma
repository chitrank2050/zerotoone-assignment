// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   // 'admin' or 'planner'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]

  @@index([email])
}

model Conversation {
  id        String   @id @default(uuid())
  title     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  messages  Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String       // 'user' or 'agent'
  content        String
  metadata       String?      // JSON string for structured signals or tools
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model LocationTaxonomy {
  id         String   @id @default(uuid())
  externalId String   @unique
  name       String
  path       String
  parentId   String?
  parent     LocationTaxonomy?  @relation("Hierarchy", fields: [parentId], references: [id])
  children   LocationTaxonomy[] @relation("Hierarchy")

  @@index([externalId])
  @@index([parentId])
}

model TransactionTaxonomy {
  id         String   @id @default(uuid())
  externalId String   @unique
  name       String
  path       String
  parentId   String?
  parent     TransactionTaxonomy?  @relation("Hierarchy", fields: [parentId], references: [id])
  children   TransactionTaxonomy[] @relation("Hierarchy")

  @@index([externalId])
  @@index([parentId])
}

model DataDictionary {
  id               String  @id @default(uuid())
  fieldName        String  @unique
  fieldDescription String
  fieldType        String
  attributes       String?
  fieldValues      String?
  minRange         Float?
  maxRange         Float?
}

model FieldValue {
  id               String @id @default(uuid())
  fieldName        String
  value            String
  description      String

  @@unique([fieldName, value])
}

model AudienceSegment {
  id             String   @id @default(uuid())
  name           String
  signals        String   // JSON string of targeting signals
  sizeEstimate   Int
  createdAt      DateTime @default(now())
}
