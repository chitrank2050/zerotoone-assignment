# API_PREFIX and API_VERSION control the global route prefix.
# All routes will be: /api/v1/tenants, /api/v1/usage, etc.
API_PREFIX=api
API_VERSION=v1

# Application Configuration
NODE_ENV=development
PORT=3000

# Security (Change these in production!)
JWT_SECRET=super-secret-key-change-this-in-production

# External APIs
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Database (PostgreSQL - Neon)
DATABASE_URL="postgres://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Cache (Redis - Upstash)
# Format: rediss://default:PASSWORD@ENDPOINT:6379
REDIS_URL="rediss://default:your-password@your-endpoint.upstash.io:6379"

# CORS (Comma separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173
