{
  "name": "audience-builder-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm run lint:md",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .prettierignore",
    "db:deploy": "pnpm --filter backend run db:deploy",
    "db:migrate": "pnpm --filter backend run db:migrate",
    "db:generate": "pnpm --filter backend run db:generate",
    "docker:up": "docker compose up -d",
    "docker:build": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "lint:md": "markdownlint \"**/*.md\" --fix --ignore node_modules"
  },
  "devDependencies": {
    "@chitrank2050/git-hygiene": "^0.4.12",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "latest",
    "turbo": "latest",
    "typescript-eslint": "^8.59.2"
  },
  "packageManager": "pnpm@10.33.2",
  "git-hygiene": {
    "types": [
      "feat",
      "fix",
      "chore",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "revert"
    ],
    "ignoreBranches": [
      "main",
      "master",
      "gh-pages"
    ]
  }
}
