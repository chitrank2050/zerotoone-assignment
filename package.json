{
  "name": "audience-builder-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "AI-driven audience segmentation and targeting platform.",
  "author": {
    "name": "Chitrank Agnihotri",
    "email": "chitrank2050@gmail.com",
    "url": "https://www.chitrankagnihotri.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chitrank2050/zerotoone-assignment"
  },
  "bugs": {
    "url": "https://github.com/chitrank2050/zerotoone-assignment/issues"
  },
  "keywords": [
    "ai",
    "audience-builder",
    "targeting",
    "advertising",
    "segmentation",
    "nestjs",
    "react",
    "turborepo",
    "gemini-ai",
    "libsql",
    "prisma",
    "monorepo",
    "typescript"
  ],
  "scripts": {
    "// --- 🚀 Core ---": "",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter backend run start:prod",
    "// --- 🧹 Hygiene ---": "",
    "lint": "turbo run lint && pnpm run lint:md",
    "lint:md": "markdownlint \"**/*.md\" --fix --ignore node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .prettierignore",
    "check-types": "turbo run check-types",
    "// --- 🧪 Testing ---": "",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e",
    "test:cov": "turbo run test:cov",
    "// --- 🗄️ Database ---": "",
    "db:migrate": "pnpm --filter backend run db:migrate",
    "db:generate": "pnpm --filter backend run db:generate",
    "db:deploy": "pnpm --filter backend run db:deploy",
    "db:seed": "pnpm --filter backend run db:seed",
    "// --- 🏗️ Infrastructure ---": "",
    "docker:init": "docker compose down -v && pnpm docker:build",
    "docker:up": "docker compose up -d",
    "docker:build": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "// --- ⚙️ Maintenance ---": "",
    "setup": "pnpm install --force && pnpm run db:generate && pnpm run db:deploy",
    "db:reset": "pnpm --filter backend run db:migrate reset --force",
    "nuke": "rm -rf node_modules pnpm-lock.yaml && pnpm install"
  },
  "devDependencies": {
    "@chitrank2050/git-hygiene": "^0.4.12",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "git-hygiene": {
    "ignoreBranches": [
      "main"
    ]
  }
}